{
  "name": "solar-epc-crm",
  "version": "1.0.0",
  "private": true,
  "description": "Production-grade Solar EPC CRM (Local-first, Mobile-first PWA) with NestJS & Supabase",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "build": "node scripts/build-netlify.cjs",
    "dev:api": "npm --workspace=apps/api run start:dev",
    "dev:web": "npm --workspace=apps/web run dev",
    "build:api": "npm --workspace=apps/api run build",
    "build:web": "node scripts/build-netlify.cjs",
    "lint": "npm --workspaces run lint",
    "test": "npm --workspaces run test",
    "seed": "npm --workspace=apps/api run seed",
    "seed:reset": "npm --workspace=apps/api run seed:reset"
  },
  "keywords": [
    "solar",
    "crm",
    "epc",
    "pwa",
    "nestjs",
    "supabase",
    "react",
    "vite"
  ],
  "author": "Kyros Solar Engineering",
  "license": "UNLICENSED",
  "devDependencies": {
    "turbo": "2.11.10"
  }
}
