{
  "name": "@solar-crm/api",
  "version": "1.0.0",
  "description": "Solar EPC CRM Backend API (NestJS + Supabase)",
  "private": true,
  "scripts": {
    "dev": "node ../../scripts/start-api.cjs",
    "build": "node scripts/build.cjs",
    "start": "node --max-old-space-size=400 dist/main",
    "start:dev": "node ../../scripts/start-api.cjs",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node --max-old-space-size=400 dist/main",
    "lint": "tsc --noEmit",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "migrate": "ts-node -r tsconfig-paths/register src/scripts/migrate.ts",
    "seed": "ts-node -r tsconfig-paths/register src/scripts/seed.ts",
    "seed:reset": "ts-node -r tsconfig-paths/register src/scripts/reset.ts"
  },
  "dependencies": {
    "@nestjs/cli": "^10.3.0",
    "@nestjs/common": "^10.3.0",
    "@nestjs/core": "^10.3.0",
    "@nestjs/platform-express": "^10.3.0",
    "@nestjs/schematics": "^10.1.0",
    "@nestjs/throttler": "^5.1.1",
    "@supabase/supabase-js": "^2.39.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "compression": "^1.7.4",
    "dotenv": "^16.4.1",
    "exceljs": "^4.4.0",
    "helmet": "^7.1.0",
    "pdfmake": "^0.2.9",
    "pg": "^8.11.3",
    "reflect-metadata": "^0.2.1",
    "rxjs": "^7.8.1",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.3.3"
  },
  "devDependencies": {
    "@nestjs/testing": "^10.3.0",
    "@types/compression": "^1.7.5",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.11",
    "@types/multer": "^1.4.11",
    "@types/node": "^20.11.0",
    "@types/pdfmake": "^0.2.8",
    "@types/pg": "^8.11.0",
    "@types/supertest": "^6.0.2",
    "jest": "^29.7.0",
    "supertest": "^6.3.4",
    "ts-jest": "^29.1.1"
  },
  "jest": {
    "moduleFileExtensions": ["js", "json", "ts"],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": ["**/*.(t|j)s"],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  }
}
