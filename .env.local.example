# ==============================================================================
# Solar EPC CRM — LOCAL DEVELOPMENT Environment Configuration (.env.local)
# ==============================================================================
# Copy this file to .env (or .env.local) for local development:
#   cp .env.local.example .env
#
# IMPORTANT: Never commit your actual .env or .env.local file to version control!
# ==============================================================================

# ------------------------------------------------------------------------------
# Backend API Service (@solar-crm/api)
# ------------------------------------------------------------------------------
NODE_ENV=development
PORT=3002

# Supabase Development Project Credentials
# (Obtain from your Supabase Dashboard: Project Settings -> API)
SUPABASE_URL=https://your-dev-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# Direct PostgreSQL Database Connection
# Format: postgresql://postgres.[project-ref]:[db-password]@[host]:[port]/postgres
DATABASE_URL=postgresql://postgres.your-project-ref:your_database_password@aws-0-ap-south-1.pooler.supabase.com:6543/postgres

# Application Security & Token Settings
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
JWT_SECRET=kyros-solar-dev-jwt-secret-key-32chars
REPORT_SHARE_SALT=a7f9c2d4e8b103756f294819dcae6123

# Allow instant seed/demo user logins during local development
ENABLE_DEMO_AUTH=true

# Memory ceiling for local Node runtime
NODE_OPTIONS=--max-old-space-size=400

# ------------------------------------------------------------------------------
# Frontend Client Web App (@solar-crm/web - Vite)
# ------------------------------------------------------------------------------
# All client-side environment variables MUST be prefixed with VITE_
VITE_API_URL=http://localhost:3002/api
VITE_SUPABASE_URL=https://your-dev-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here
