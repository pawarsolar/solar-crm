# ==============================================================================
# Solar EPC CRM — Environment Configuration
# ==============================================================================

# Node Environment
NODE_ENV=development
PORT=3000

# Supabase Local or Cloud Credentials
# Client (PWA) only receives Anon Key; API server alone uses Service Role Key
SUPABASE_URL=http://localhost:54321
SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# Database Connection (Pooled Postgres string for NestJS direct query/views)
DATABASE_URL=postgresql://postgres:postgres@localhost:54322/postgres

# Application Settings
CORS_ORIGIN=http://localhost:5173
JWT_SECRET=your_jwt_signing_secret_here
REPORT_SHARE_SALT=your_report_share_salt_here

# Node memory settings
# Frontend build requires 4096MB. Do NOT set to 256MB in Netlify / Vercel frontend environments.
NODE_OPTIONS=--max-old-space-size=4096

# Client Environment (Vite prefix VITE_)
VITE_SUPABASE_URL=http://localhost:54321
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here
# For Local Dev: http://localhost:3002/api
# For Netlify + Render: https://solar-crm-api.onrender.com/api
VITE_API_URL=http://localhost:3002/api
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_anon_key
SUPABASE_SECRET_KEY=your_supabase_service_role_secret_key
SUPABASE_JWKS_URL=https://your-project.supabase.co/auth/v1/.well-known/jwks.json

# Development & Preview Login Flag
ENABLE_DEMO_AUTH=true

# Netlify CI/CD Deployment
NETLIFY_AUTH_TOKEN=your_netlify_personal_access_token
NETLIFY_SITE_ID=your_netlify_site_id

# Render Web Service Deployment (apps/api)
# Build Command: npm install && npm --workspace=apps/api run build (or npm run build)
# Start Command: node --max-old-space-size=400 apps/api/dist/main (or npm start)
# Health Check Path: /api/health
RENDER_SERVICE_NAME=solar-crm-06uk
RENDER_EXTERNAL_URL=https://solar-crm-06uk.onrender.com
RENDER_API_URL=https://solar-crm-06uk.onrender.com