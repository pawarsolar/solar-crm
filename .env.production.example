# ==============================================================================
# Solar EPC CRM — PRODUCTION Environment Configuration (.env.production)
# ==============================================================================
# Use these environment variables when configuring your production hosting:
#   - Backend: Render Web Service Dashboard (solar-crm-06uk)
#   - Frontend: Netlify Site Dashboard (pawarsolar-crm)
#
# IMPORTANT: DO NOT commit your live production .env or secrets to Git!
# ==============================================================================

# ==============================================================================
# 1. RENDER WEB SERVICE CONFIGURATION (Backend: @solar-crm/api)
# Set these in: Render Dashboard -> Web Service -> Environment
# ==============================================================================
NODE_ENV=production
NODE_VERSION=20.18.0

# Render automatically injects PORT (default 10000). 
# NestJS listens on process.env.PORT on 0.0.0.0
PORT=10000

# Live Supabase Production Project Credentials
# (Service Role Key MUST remain server-side and NEVER be shared with frontend)
SUPABASE_URL=https://xkbititevicweaadwcio.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_production_supabase_service_role_key

# Supabase Production PostgreSQL Direct Pooler Connection String
# Obtain from: Supabase Dashboard -> Project Settings -> Database -> Connection string (URI)
DATABASE_URL=postgresql://postgres.xkbititevicweaadwcio:YOUR_PROD_DB_PASSWORD@aws-0-ap-south-1.pooler.supabase.com:6543/postgres

# Production CORS & Security Settings
# Allow requests from your Netlify domain and Render domain
FRONTEND_URL=https://pawarsolar-crm.netlify.app
CORS_ORIGIN=https://pawarsolar-crm.netlify.app,https://solar-crm-06uk.onrender.com
JWT_SECRET=your_production_secure_jwt_random_secret_at_least_64_characters
REPORT_SHARE_SALT=your_production_unique_salt_hash_string

# Strict Security: Disable demo auth bypass in production
ENABLE_DEMO_AUTH=false

# Keep memory below 350MB to stay within Render's 512MB RAM free-tier limit
NODE_OPTIONS=--max-old-space-size=350

# ==============================================================================
# 2. NETLIFY SITE CONFIGURATION (Frontend: @solar-crm/web)
# Set these in: Netlify Dashboard -> Site configuration -> Environment variables
# ==============================================================================
# Node version for Netlify build container
NODE_VERSION=20
NODE_OPTIONS=--max-old-space-size=4096

# Reverse Proxy API Target:
# KEEP AS '/api' so Netlify's CDN edge redirects /api/* to Render with zero CORS issues!
VITE_API_URL=/api

# Client-Side Supabase (Publishable/Anon key only)
VITE_SUPABASE_URL=https://xkbititevicweaadwcio.supabase.co
VITE_SUPABASE_ANON_KEY=your_production_supabase_anon_public_key
